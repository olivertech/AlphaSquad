@page
@model AlphaSquad.Backoffice.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_AuthLayout";
}

<div class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center px-4 py-10">
    <div class="grid w-full gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <section class="relative overflow-hidden rounded-[2rem] border border-white/20 bg-slate-950 p-8 text-white shadow-2xl shadow-slate-950/20">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(124,58,237,0.28),_transparent_35%),radial-gradient(circle_at_bottom_right,_rgba(56,189,248,0.18),_transparent_28%)]"></div>
            <div class="relative space-y-8">
                <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-slate-200">
                    <span class="inline-flex h-2.5 w-2.5 rounded-full bg-violet-400"></span>
                    Backoffice AlphaSquad
                </div>

                <div class="space-y-4">
                    <p class="text-sm uppercase tracking-[0.28em] text-violet-300">Controle da plataforma</p>
                    <h1 class="max-w-xl text-4xl font-semibold leading-tight sm:text-5xl">
                        A AlphaSquad em uma visao ampla, pronta para ativar novas academias.
                    </h1>
                    <p class="max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
                        Cadastre academias, organize modulos contratados, acompanhe a base ativa e entregue o onboarding inicial com seguranca.
                    </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-3">
                    <article class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-sm text-slate-300">Visao consolidada</p>
                        <h2 class="mt-3 text-xl font-medium">Base de academias</h2>
                    </article>
                    <article class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-sm text-slate-300">Onboarding assistido</p>
                        <h2 class="mt-3 text-xl font-medium">Branding + modulos + admin</h2>
                    </article>
                    <article class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-sm text-slate-300">Operacao segura</p>
                        <h2 class="mt-3 text-xl font-medium">Acesso separado do tenant</h2>
                    </article>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-8">
            <div class="mb-8 space-y-3">
                <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-500/10 text-violet-700">
                    <span class="material-symbols-rounded text-3xl">shield_person</span>
                </div>
                <div>
                    <h2 class="text-3xl font-semibold tracking-tight text-slate-900">Entrar no backoffice</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">
                        Este acesso e exclusivo para a equipe da AlphaSquad responsavel pelo onboarding e pela visao global da plataforma.
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-error mb-6 rounded-2xl border border-rose-200 bg-rose-50 text-rose-700">
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" class="space-y-5">
                <input type="hidden" asp-for="ReturnUrl" />

                <div>
                    <label asp-for="Input.Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Input.Email" class="input input-bordered h-12 w-full rounded-2xl border-slate-200 bg-slate-50 text-base" placeholder="owner@alphasquad.app" />
                    <span asp-validation-for="Input.Email" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <div x-data="{ mostrarSenha: false }">
                    <label asp-for="Input.Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <div class="relative">
                        <input asp-for="Input.Password"
                               x-bind:type="mostrarSenha ? 'text' : 'password'"
                               class="input input-bordered h-12 w-full rounded-2xl border-slate-200 bg-slate-50 pr-14 text-base"
                               placeholder="Sua senha" />
                        <button type="button"
                                x-on:click="mostrarSenha = !mostrarSenha"
                                x-bind:aria-label="mostrarSenha ? 'Ocultar senha' : 'Mostrar senha'"
                                class="absolute inset-y-0 right-3 inline-flex items-center justify-center text-slate-400 transition hover:text-slate-700">
                            <svg x-show="!mostrarSenha" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" />
                            </svg>
                            <svg x-show="mostrarSenha" x-cloak xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m3 3 18 18" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.58 10.58A2.25 2.25 0 0 0 12 14.25c.52 0 1-.177 1.38-.474" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A9.94 9.94 0 0 1 12 4.875c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 0 1-4.304 5.38M6.228 6.228A9.97 9.97 0 0 0 2.458 12c1.274 4.057 5.064 7 9.542 7 1.563 0 3.04-.359 4.354-.998" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <button type="submit" class="btn h-12 w-full rounded-2xl border-0 bg-slate-950 text-base font-medium text-white hover:bg-slate-800">
                    Entrar no backoffice
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
