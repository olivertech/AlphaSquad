@page
@model AlphaSquad.Backoffice.Pages.Backoffice.Profile.ManageModel
@{
    ViewData["Title"] = "Gerenciar Perfil";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Backoffice/Index" class="hover:text-slate-700">Backoffice</a></li>
            <li><a asp-page="/Backoffice/Profile/Index" class="hover:text-slate-700">Meu Perfil</a></li>
            <li class="font-medium tenant-text">Gerenciamento</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Gerenciar Perfil</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Atualize seu nome, sua foto e a senha de acesso do backoffice da AlphaSquad.
        </p>
    </div>

    @if (Model.LoadErrorMessage is null)
    {
        <div class="grid gap-6 lg:grid-cols-[0.6fr_1fr]">
            <div class="space-y-6">
                <section x-data="photoUpload()" class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70 p-8 flex flex-col items-center text-center gap-6">
                    <div class="relative group">
                        <template x-if="previewUrl">
                            <img :src="previewUrl" alt="Preview da nova foto" class="h-40 w-40 rounded-full object-cover border-4 border-violet-200 shadow-md ring-4 ring-violet-100/60 transition" />
                        </template>

                        <template x-if="!previewUrl">
                            @if (!string.IsNullOrEmpty(Model.Input.PhotoUrl))
                            {
                                <img src="@Model.Input.PhotoUrl" alt="Sua foto" class="h-40 w-40 rounded-full object-cover border-4 border-slate-100 shadow-md transition group-hover:brightness-90" />
                            }
                            else
                            {
                                <div class="flex h-40 w-40 items-center justify-center rounded-full text-5xl font-semibold text-white shadow-md"
                                     style="background: var(--tenant-primary);">
                                    @Model.Initials
                                </div>
                            }
                        </template>
                    </div>

                    <div class="space-y-2">
                        <h3 class="text-lg font-semibold text-slate-900">Foto do Owner</h3>
                        <p class="text-xs text-slate-500" x-show="!previewUrl">Sua imagem visivel no header do backoffice.</p>
                        <p class="text-xs font-medium text-violet-600" x-show="previewUrl" x-transition>Previa da nova foto - confirme ou cancele abaixo.</p>
                    </div>

                    <div class="flex flex-col gap-3 w-full pt-4">
                        <form method="post" asp-page-handler="UploadPhoto" enctype="multipart/form-data" x-ref="uploadForm" class="flex flex-col gap-2">
                            <label x-show="!previewUrl"
                                   class="flex cursor-pointer flex-col items-center justify-center w-full h-24 border-2 border-slate-300 border-dashed rounded-2xl bg-slate-50 hover:bg-slate-100 transition relative overflow-hidden">
                                <span class="material-symbols-rounded text-2xl text-slate-400 mb-1">add_a_photo</span>
                                <span class="text-xs font-semibold text-slate-600">Alterar Foto</span>
                                <input type="file" name="photo" accept="image/*" x-ref="fileInput" class="absolute inset-0 opacity-0 cursor-pointer" @@change="onFileSelected($event)" />
                            </label>

                            <div x-show="previewUrl" x-transition class="flex flex-col gap-2">
                                <button type="submit" class="rounded-full px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95" style="background: var(--tenant-primary);">
                                    Confirmar e Salvar Foto
                                </button>
                                <button type="button" @@click="cancelPreview()" class="rounded-full border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:bg-slate-50">
                                    Cancelar Alteracao
                                </button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.Input.PhotoUrl))
                        {
                            <form method="post" asp-page-handler="DeletePhoto" x-show="!previewUrl">
                                <button type="submit" class="w-full rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
                                    Remover Foto
                                </button>
                            </form>
                        }
                    </div>
                </section>

                <a asp-page="/Backoffice/Profile/Index"
                   class="flex items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                    Cancelar e Voltar
                </a>
            </div>

            <div class="space-y-6">
                <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Dados Pessoais</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">Mantenha nome e e-mail atualizados para o backoffice.</p>
                    </div>
                    <form method="post" asp-page-handler="Update" class="p-6 sm:px-8 py-6 space-y-6">
                        <div class="grid gap-5 md:grid-cols-2">
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">Nome Completo</span>
                                <input asp-for="Input.Name" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                                <span asp-validation-for="Input.Name" class="mt-2 text-sm text-rose-600"></span>
                            </label>
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">E-mail</span>
                                <input asp-for="Input.Email" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-slate-50 text-slate-500" readonly />
                            </label>
                        </div>
                        <div class="flex justify-end border-t border-slate-100 pt-6">
                            <button type="submit" class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95" style="background: var(--tenant-primary);">
                                Salvar Alteracoes
                            </button>
                        </div>
                    </form>
                </section>

                <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Seguranca da Conta</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">Altere sua senha de acesso com seguranca.</p>
                    </div>
                    <form method="post" asp-page-handler="ChangePassword" class="p-6 sm:px-8 py-6 space-y-6">
                        <div class="space-y-4">
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">Senha Atual</span>
                                <input asp-for="Input.CurrentPassword" type="password" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                            </label>
                            <div class="grid gap-5 md:grid-cols-2">
                                <label class="form-control">
                                    <span class="mb-2 text-sm font-medium text-slate-700">Nova Senha</span>
                                    <input asp-for="Input.NewPassword" type="password" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                                    <span asp-validation-for="Input.NewPassword" class="mt-2 text-sm text-rose-600"></span>
                                </label>
                                <label class="form-control">
                                    <span class="mb-2 text-sm font-medium text-slate-700">Confirmar Nova Senha</span>
                                    <input asp-for="Input.ConfirmPassword" type="password" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                                    <span asp-validation-for="Input.ConfirmPassword" class="mt-2 text-sm text-rose-600"></span>
                                </label>
                            </div>
                        </div>
                        <div class="flex justify-end border-t border-slate-100 pt-6">
                            <button type="submit" class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95" style="background: var(--tenant-primary);">
                                Atualizar Senha
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    }
</section>

<partial name="_ValidationScriptsPartial" />

@section Scripts {
    <script>
        function photoUpload() {
            return {
                previewUrl: null,
                onFileSelected(event) {
                    const file = event.target.files[0];
                    if (!file || !file.type.startsWith('image/')) {
                        event.target.value = '';
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        this.previewUrl = e.target.result;
                    };
                    reader.readAsDataURL(file);
                },
                cancelPreview() {
                    this.previewUrl = null;
                    if (this.$refs.fileInput) {
                        this.$refs.fileInput.value = '';
                    }
                }
            };
        }
    </script>
}
