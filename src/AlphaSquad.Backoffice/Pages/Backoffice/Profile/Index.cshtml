@page
@model AlphaSquad.Backoffice.Pages.Backoffice.Profile.IndexModel
@{
    ViewData["Title"] = "Meu perfil";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Backoffice/Index" class="hover:text-slate-700">Backoffice</a></li>
            <li class="font-medium text-slate-900">Meu Perfil</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Meu Perfil</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Confira seus dados e gerencie as configuracoes da sua conta de owner da AlphaSquad.
        </p>
    </div>

    @if (Model.Profile is not null)
    {
        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Visao Geral</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Informacoes vinculadas ao seu acesso no backoffice da AlphaSquad.
                </p>
            </div>

            <div class="grid gap-6 px-6 py-6 lg:grid-cols-[0.2fr_1fr] sm:px-8">
                <div class="flex items-center justify-center">
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.ProfilePhotoUrl))
                    {
                        <img src="@Model.Profile.ProfilePhotoUrl" alt="Foto do owner" class="h-32 w-32 rounded-full object-cover ring-4 ring-slate-100 shadow-md" />
                    }
                    else
                    {
                        <div class="flex h-32 w-32 items-center justify-center rounded-full text-4xl font-semibold text-white shadow-md"
                             style="background: var(--tenant-primary);">
                            @Model.Profile.Initials
                        </div>
                    }
                </div>

                <div class="space-y-5">
                    <div>
                        <h3 class="text-2xl font-semibold text-slate-950">@Model.Profile.Name</h3>
                        <p class="mt-1 text-lg text-slate-600">@Model.Profile.Email</p>
                    </div>

                    <div class="grid gap-4 md:grid-cols-3">
                        <div class="rounded-[1.5rem] border border-slate-200 bg-white px-5 py-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Identificacao</p>
                            <p class="mt-3 text-base font-semibold text-slate-900">@Model.Profile.Name</p>
                        </div>
                        <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Contato</p>
                            <p class="mt-3 text-base font-semibold text-slate-900">@Model.Profile.Email</p>
                        </div>
                        <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Perfil</p>
                            <p class="mt-3 text-base font-semibold text-slate-900">@Model.Profile.RoleLabel</p>
                        </div>
                    </div>

                    <div>
                        <a asp-page="/Backoffice/Profile/Manage"
                           class="inline-flex rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                           style="background: var(--tenant-primary);">
                            Gerenciar Perfil
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }
</section>
