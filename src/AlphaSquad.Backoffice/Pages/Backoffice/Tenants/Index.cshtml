@page
@model AlphaSquad.Backoffice.Pages.Backoffice.Tenants.IndexModel
@{
    ViewData["Title"] = "Academias";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Backoffice/Index" class="hover:text-slate-700">Backoffice</a></li>
            <li>Operacao da plataforma</li>
            <li class="font-medium text-slate-900">Academias</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950">Academias da AlphaSquad</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Gerencie a base de academias cadastradas, acompanhe branding, modulos contratados e o administrador principal de cada operacao.
        </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Total de academias</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalTenants</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Quantidade total de clientes atualmente provisionados pela plataforma.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Ativas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.ActiveTenants</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Academias liberadas para operar normalmente com seus modulos contratados.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Inativas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.InactiveTenants</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Academias mantidas em historico ou temporariamente bloqueadas pela operacao.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Onboardings pendentes</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.PendingPasswordChanges</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Admins iniciais que ainda devem substituir a senha provisoria no primeiro acesso.</p>
        </article>
    </div>

    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
        <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
            <div>
                <h2 class="text-xl font-semibold tenant-text">Base de academias</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Consulte branding, status, modulos e administrador principal de cada academia atendida pela AlphaSquad.
                </p>
            </div>
            <a asp-page="/Backoffice/Tenants/Create"
               class="rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
               style="background: var(--tenant-primary);">
                Nova academia
            </a>
        </div>

        @if (Model.Tenants.Count == 0)
        {
            <div class="px-6 py-10 text-center sm:px-8">
                <div class="tenant-soft-bg mx-auto max-w-xl rounded-[1.75rem] border tenant-soft-border px-8 py-10">
                    <p class="text-base font-medium text-slate-700">
                        Ainda nao ha academias cadastradas nesta base de backoffice.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr class="text-slate-500">
                            <th>Academia</th>
                            <th>Admin principal</th>
                            <th>Modulos</th>
                            <th>Status</th>
                            <th>Criada em</th>
                            <th class="text-right">Acoes</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr class="hover">
                            <td>
                                <div class="flex items-center gap-4">
                                    @if (!string.IsNullOrWhiteSpace(tenant.LogoUrl))
                                    {
                                        <img src="@tenant.LogoUrl" alt="Logo da academia" class="h-11 w-11 rounded-2xl object-cover ring-1 ring-slate-200" />
                                    }
                                    else
                                    {
                                        <div class="flex h-11 w-11 items-center justify-center rounded-2xl text-white ring-1 ring-slate-200"
                                             style="background:@tenant.PrimaryColor;">
                                            <span class="text-sm font-semibold">@tenant.Name[..1].ToUpperInvariant()</span>
                                        </div>
                                    }
                                    <div>
                                        <div class="font-semibold text-slate-900">@tenant.Name</div>
                                        <div class="text-sm text-slate-500">@tenant.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="font-medium text-slate-800">@tenant.PrimaryAdminName</div>
                                <div class="text-sm text-slate-500">@tenant.PrimaryAdminEmail</div>
                            </td>
                            <td class="text-slate-600">@tenant.FeatureCount modulos</td>
                            <td>
                                <span class="rounded-full px-3 py-1 text-xs font-semibold @(tenant.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                                    @tenant.StatusLabel
                                </span>
                            </td>
                            <td class="text-slate-600">@tenant.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="flex justify-end gap-2">
                                    <a asp-page="/Backoffice/Tenants/Details"
                                       asp-route-id="@tenant.Id"
                                       class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                                        Ver
                                    </a>
                                    <a asp-page="/Backoffice/Tenants/Edit"
                                       asp-route-id="@tenant.Id"
                                       class="rounded-full px-4 py-2 text-xs font-semibold text-white transition hover:brightness-95"
                                       style="background: var(--tenant-primary);">
                                        Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
