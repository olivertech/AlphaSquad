@page
@model AlphaSquad.Backoffice.Pages.Backoffice.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li>Backoffice</li>
            <li class="font-medium text-slate-900">Dashboard</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950">Visao geral da AlphaSquad</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Acompanhe a base de academias provisionadas, os modulos liberados e a capacidade operacional da plataforma.
        </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Academias cadastradas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalTenants</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Base total de academias atualmente provisionadas pela AlphaSquad.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Academias ativas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.ActiveTenants</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Academias liberadas para operar normalmente no ecossistema.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Onboardings com troca obrigatoria</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.PendingPasswordChanges</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Administradores iniciais que ainda devem trocar a senha provisoria.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Modulos contratados</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalContractedModules</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Soma dos modulos habilitados em todas as academias cadastradas.</p>
        </article>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Academias recentes</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Ultimas academias registradas no backoffice, prontas para acompanhamento ou ajuste.
                </p>
            </div>

            <div class="overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr class="text-slate-500">
                            <th>Academia</th>
                            <th>Admin principal</th>
                            <th>Modulos</th>
                            <th>Status</th>
                            <th>Criada em</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var tenant in Model.RecentTenants)
                    {
                        <tr class="hover">
                            <td>
                                <div class="font-semibold text-slate-900">@tenant.Name</div>
                                <div class="text-sm text-slate-500">@tenant.Slug</div>
                            </td>
                            <td>
                                <div class="font-medium text-slate-800">@tenant.PrimaryAdminName</div>
                                <div class="text-sm text-slate-500">@tenant.PrimaryAdminEmail</div>
                            </td>
                            <td class="text-slate-600">@tenant.FeatureCount</td>
                            <td>
                                <span class="rounded-full px-3 py-1 text-xs font-semibold @(tenant.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                                    @tenant.StatusLabel
                                </span>
                            </td>
                            <td class="text-slate-600">@tenant.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5">
                <h2 class="text-xl font-semibold tenant-text">Atalhos do sponsor</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Caminhos rapidos para o onboarding e a gestao da base.
                </p>
            </div>
            <div class="space-y-4 px-6 py-6">
                <a asp-page="/Backoffice/Tenants/Create"
                   class="block rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4 transition hover:border-slate-300 hover:bg-slate-100">
                    <p class="text-sm font-semibold text-slate-900">Nova academia</p>
                    <p class="mt-1 text-sm leading-6 text-slate-500">Inicie um novo onboarding com branding, modulos e admin inicial.</p>
                </a>

                <a asp-page="/Backoffice/Tenants/Index"
                   class="block rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4 transition hover:border-slate-300 hover:bg-slate-100">
                    <p class="text-sm font-semibold text-slate-900">Base completa de academias</p>
                    <p class="mt-1 text-sm leading-6 text-slate-500">Veja a lista consolidada, detalhes e status operacional da base.</p>
                </a>
            </div>
        </section>
    </div>
</section>
