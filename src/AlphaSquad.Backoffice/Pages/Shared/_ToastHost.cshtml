@{
    var toastType = (ViewData["Backoffice.Toast.Type"] as string) ?? TempData["Backoffice.Toast.Type"]?.ToString();
    var toastMessage = (ViewData["Backoffice.Toast.Message"] as string) ?? TempData["Backoffice.Toast.Message"]?.ToString();
    var toastTitle = (ViewData["Backoffice.Toast.Title"] as string) ?? TempData["Backoffice.Toast.Title"]?.ToString();

    var icon = toastType switch
    {
        "success" => "check_circle",
        "error" => "error",
        "warning" => "warning",
        _ => "info"
    };

    var accentClass = toastType switch
    {
        "success" => "border-emerald-200 bg-emerald-50 text-emerald-900",
        "error" => "border-rose-200 bg-rose-50 text-rose-900",
        "warning" => "border-amber-200 bg-amber-50 text-amber-900",
        _ => "border-sky-200 bg-sky-50 text-sky-900"
    };
}

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="pointer-events-none absolute right-4 top-6 z-30 w-full max-w-md sm:right-6 lg:right-8">
        <div x-data="{ open: true }"
             x-show="open"
             x-transition.opacity.duration.200ms
             x-init="setTimeout(() => open = false, 4500)"
             class="pointer-events-auto rounded-[1.5rem] border shadow-lg shadow-slate-200/70 @accentClass">
            <div class="flex items-start gap-4 px-5 py-4">
                <span class="dashboard-menu-icon mt-0.5">
                    <span class="material-symbols-rounded dashboard-material-icon">@icon</span>
                </span>
                <div class="min-w-0 flex-1">
                    @if (!string.IsNullOrWhiteSpace(toastTitle))
                    {
                        <p class="text-sm font-semibold">@toastTitle</p>
                    }
                    <p class="text-sm leading-6">@toastMessage</p>
                </div>
                <button type="button"
                        class="rounded-full p-1 text-current/70 transition hover:bg-black/5 hover:text-current"
                        @@click="open = false">
                    <span class="material-symbols-rounded text-xl">close</span>
                </button>
            </div>
        </div>
    </div>
}
