@page "{metricKey}"
@model AlphaSquad.Web.Pages.Dashboard.Metrics.DetailsModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Metric?.Title ?? "Medidor";
}

@if (Model.Metric is null)
{
    <section class="space-y-4">
        <nav class="breadcrumbs px-1 text-sm text-slate-500">
            <ul>
                <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
                <li>Medidores</li>
                <li class="font-medium tenant-text">Não encontrado</li>
            </ul>
        </nav>
        <div class="rounded-[2rem] border border-slate-200 bg-white p-10 shadow-sm shadow-slate-200/70">
            <h1 class="text-2xl font-semibold tenant-text">Medidor não encontrado</h1>
            <p class="mt-3 text-sm leading-7 text-slate-500">
                O medidor solicitado não existe no catálogo atual do dashboard.
            </p>
        </div>
    </section>
}
else
{
    var chartOptionsJson = JsonSerializer.Serialize(Model.ChartOptions);

    <section class="space-y-6">
        <nav class="breadcrumbs px-1 text-sm text-slate-500">
            <ul>
                <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
                <li>Medidores</li>
                <li class="font-medium tenant-text">@Model.Metric.Title</li>
            </ul>
        </nav>

        <div class="flex flex-col gap-4 px-1 xl:flex-row xl:items-start xl:justify-between">
            <div class="space-y-2">
                <h1 class="text-3xl font-semibold tracking-tight tenant-text">@Model.Metric.DetailPageTitle</h1>
                <p class="max-w-3xl text-sm leading-7 text-slate-500">@Model.Metric.DetailDescription</p>
            </div>

            <div class="w-full rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/70 xl:max-w-md">
                <label for="metric-switcher" class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">
                    Trocar medidor
                </label>
                <div class="mt-3 flex items-center gap-3">
                    <select id="metric-switcher"
                            class="select select-bordered w-full rounded-full border-slate-200 bg-slate-50"
                            onchange="if(this.value){ window.location.href = '/Dashboard/Metrics/' + this.value; }">
                        @foreach (var metric in Model.AvailableMetrics)
                        {
                            <option value="@metric.Key" selected="@(metric.Key == Model.Metric.Key)">
                                @metric.Title
                            </option>
                        }
                    </select>
                    <span class="dashboard-menu-icon shrink-0 rounded-full tenant-soft-bg p-2 tenant-text">
                        <span class="material-symbols-rounded dashboard-material-icon">monitoring</span>
                    </span>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-500">
                    Use este atalho para alternar rapidamente entre os medidores do dashboard sem precisar voltar à tela inicial.
                </p>
            </div>
        </div>

        <div class="grid gap-6 xl:grid-cols-[1.6fr_0.9fr]">
            <section class="rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <h2 class="text-xl font-semibold tenant-text">Gráfico do medidor</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-500">
                        O formato foi escolhido para facilitar a leitura deste indicador na rotina da academia.
                    </p>
                </div>
                <div class="px-6 py-6 sm:px-8">
                    <div id="metric-chart" class="min-h-[360px]"></div>
                </div>
            </section>

            <aside class="rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5">
                    <h2 class="text-xl font-semibold tenant-text">Resumo do medidor</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-500">
                        Uma leitura rápida do que este indicador representa no contexto do AlphaSquad.
                    </p>
                </div>
                <div class="space-y-4 px-6 py-6 text-sm">
                    <div class="rounded-[1.5rem] tenant-soft-bg p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Valor resumido</p>
                        <p class="mt-2 text-3xl font-semibold tenant-text">@Model.Metric.SummaryValue</p>
                    </div>
                    <div class="rounded-[1.5rem] bg-slate-50 p-5">
                        <h3 class="font-semibold text-slate-900">O que este gráfico mostra</h3>
                        <p class="mt-2 leading-6 text-slate-600">@Model.Metric.DetailDescription</p>
                    </div>
                    <div class="rounded-[1.5rem] bg-slate-50 p-5">
                        <h3 class="font-semibold text-slate-900">Por que esse formato foi escolhido</h3>
                        <p class="mt-2 leading-6 text-slate-600">@Model.ChartExplanation</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
        <script>
            const chartOptions = @Html.Raw(chartOptionsJson);
            const metricChart = new ApexCharts(document.querySelector("#metric-chart"), chartOptions);
            metricChart.render();
        </script>
    }
}
