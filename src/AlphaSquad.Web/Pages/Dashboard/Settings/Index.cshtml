@page
@model AlphaSquad.Web.Pages.Dashboard.Settings.IndexModel
@{
    ViewData["Title"] = "Configurações";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Conta</li>
            <li class="font-medium tenant-text">Configurações</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Configurações do painel</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Ajuste a experiência do dashboard de forma simples. Os medidores escolhidos aqui ficam salvos para o seu usuário e aparecem sempre que você voltar ao painel.
        </p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.5fr_1fr]">
        <section class="rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Grupo: Medidores</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Escolha até <strong>@Model.MaxSelectableMetrics</strong> medidores para aparecer na home do dashboard. Todos continuam disponíveis para consulta individual, mesmo quando não estiverem na tela inicial.
                </p>
            </div>

            <form method="post" class="space-y-5 px-6 py-6 sm:px-8">
                @for (var i = 0; i < Model.AvailableMetrics.Count; i++)
                {
                    var metric = Model.AvailableMetrics[i];
                    var isChecked = Model.Input.SelectedMetricKeys.Contains(metric.Key, StringComparer.OrdinalIgnoreCase);

                    <label class="flex cursor-pointer items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4 transition hover:border-slate-300 hover:bg-slate-50">
                        <input type="checkbox"
                               class="checkbox checkbox-sm mt-1"
                               name="Input.SelectedMetricKeys"
                               value="@metric.Key"
                               checked="@isChecked" />
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="text-base font-semibold text-slate-950">@metric.Title</span>
                                <span class="rounded-full tenant-soft-bg px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-700">
                                    @metric.ChartKind
                                </span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-slate-500">@metric.ShortDescription</p>
                        </div>
                    </label>
                }

                <div class="flex justify-end">
                    <button type="submit" class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                            style="background: var(--tenant-primary);">
                        Salvar seleção
                    </button>
                </div>
            </form>
        </section>

        <aside class="rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5">
                <h2 class="text-xl font-semibold tenant-text">Outros grupos</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    A estrutura da página já foi preparada para receber novas configurações conforme o painel evoluir.
                </p>
            </div>

            <div class="space-y-4 px-6 py-6 text-sm">
                <div class="rounded-[1.5rem] tenant-soft-bg p-5">
                    <h3 class="font-semibold text-slate-900">Aparência do painel</h3>
                    <p class="mt-2 leading-6 text-slate-600">
                        No futuro, esta área poderá concentrar preferências de tema, densidade visual e atalhos rápidos do usuário.
                    </p>
                </div>
                <div class="rounded-[1.5rem] bg-slate-50 p-5">
                    <h3 class="font-semibold text-slate-900">Preferências operacionais</h3>
                    <p class="mt-2 leading-6 text-slate-600">
                        Este bloco pode receber filtros favoritos, períodos padrão e atalhos personalizados para cada perfil.
                    </p>
                </div>
            </div>
        </aside>
    </div>
</section>
