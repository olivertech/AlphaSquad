@page
@model AlphaSquad.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="space-y-6">
    <div class="px-1">
        <nav class="breadcrumbs text-sm text-slate-500">
            <ul>
                <li>Dashboard</li>
                <li class="font-medium tenant-text">Visão inicial</li>
            </ul>
        </nav>

        <h1 class="mt-2 text-3xl font-semibold tracking-tight tenant-text">Central da academia</h1>
        <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-500">
            Acompanhe rapidamente os principais sinais da operação da academia e use o menu lateral para acessar os módulos contratados.
        </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        @foreach (var metric in Model.SelectedMetrics)
        {
            <a asp-page="/Dashboard/Metrics/Details"
               asp-route-metricKey="@metric.Key"
               class="group rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 transition hover:-translate-y-0.5 hover:shadow-md">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">@metric.SummaryLabel</p>
                <h2 class="mt-4 text-4xl font-semibold tenant-text">@metric.SummaryValue</h2>
                <p class="mt-3 text-sm leading-6 text-slate-500">@metric.ShortDescription</p>
                <span class="mt-4 inline-flex items-center text-sm font-semibold tenant-text">
                    Ver análise
                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m13.5 4.5 6 7.5-6 7.5m-9-7.5h15" />
                    </svg>
                </span>
            </a>
        }
    </div>

    <section class="min-h-[62vh] overflow-y-auto rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
            <h2 class="text-xl font-semibold tenant-text">Painel principal</h2>
            <p class="mt-1 text-sm leading-6 text-slate-500">
                Este grande espaço ficará reservado para a evolução dos gráficos e indicadores principais do dashboard.
            </p>
        </div>

        <div class="flex min-h-[48vh] items-center justify-center px-6 py-10 sm:px-8">
            <div class="tenant-soft-bg rounded-[1.75rem] border tenant-soft-border px-8 py-10 text-center">
                <p class="text-sm font-medium text-slate-700">
                    Área reservada para os próximos gráficos, resumos e blocos analíticos do painel.
                </p>
            </div>
        </div>
    </section>
</section>
