@page
@model AlphaSquad.Web.Pages.Dashboard.Checkins.IndexModel
@{
    ViewData["Title"] = "Check-ins";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Operação</li>
            <li class="font-medium tenant-text">Check-ins</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Frequência da academia</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Acompanhe o movimento recente da academia e identifique rapidamente quem precisa de uma ação de reengajamento.
        </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Check-ins no período</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalCheckIns</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Movimento capturado conforme o filtro de datas aplicado.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Alunos únicos</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.UniqueUsers</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Pessoas diferentes que passaram pela academia no período.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Check-ins hoje</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TodayCheckIns</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Leitura rápida do ritmo do dia para a operação da academia.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Alertas de retorno</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.ReengagementAlerts</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Alunos sem check-in recente dentro da régua de reengajamento.</p>
        </article>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-700">
            @Model.LoadErrorMessage
        </div>
    }
    else
    {
        <div class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr]">
            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                        <div>
                            <h2 class="text-xl font-semibold tenant-text">Movimento recente</h2>
                            <p class="mt-1 text-sm leading-6 text-slate-500">
                                Consulte os check-ins mais recentes para apoiar decisões operacionais e leitura de frequência.
                            </p>
                        </div>
                        <form method="get" class="grid gap-3 sm:grid-cols-3">
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">De</span>
                                <input asp-for="DateFrom" type="date" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                            </label>
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">Até</span>
                                <input asp-for="DateTo" type="date" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                            </label>
                            <div class="flex items-end">
                                <button type="submit"
                                        class="w-full rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                        style="background: var(--tenant-primary);">
                                    Filtrar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                @if (Model.CheckIns.Count == 0)
                {
                    <div class="px-6 py-10 text-center sm:px-8">
                        <div class="tenant-soft-bg mx-auto max-w-xl rounded-[1.75rem] border tenant-soft-border px-8 py-10">
                            <p class="text-base font-medium text-slate-700">
                                Nenhum check-in foi encontrado para o período informado.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr class="text-slate-500">
                                    <th>Usuário</th>
                                    <th>Perfil</th>
                                    <th>Horário</th>
                                    <th>Observações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CheckIns.Take(12))
                                {
                                    <tr class="hover">
                                        <td class="font-semibold text-slate-900">@item.UserName</td>
                                        <td>
                                            <span class="rounded-full tenant-soft-bg px-3 py-1 text-xs font-semibold text-slate-700">
                                                @item.UserRoleLabel
                                            </span>
                                        </td>
                                        <td class="text-slate-600">@item.CheckedInAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-slate-600">@item.NotesPreview</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <h2 class="text-xl font-semibold tenant-text">Reengajamento</h2>
                            <p class="mt-1 text-sm leading-6 text-slate-500">
                                Alunos sem presença recente que podem receber contato, convite ou ação de retorno.
                            </p>
                        </div>
                        <form method="get" class="flex items-end gap-3">
                            <input type="hidden" asp-for="DateFrom" />
                            <input type="hidden" asp-for="DateTo" />
                            <label class="form-control">
                                <span class="mb-2 text-sm font-medium text-slate-700">Dias sem check-in</span>
                                <input asp-for="DaysWithoutCheckIn" type="number" min="1" class="input input-bordered h-12 w-36 rounded-2xl border-slate-200 bg-white" />
                            </label>
                            <button type="submit"
                                    class="rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                    style="background: var(--tenant-primary);">
                                Atualizar
                            </button>
                        </form>
                    </div>
                </div>

                <div class="space-y-4 px-6 py-6 sm:px-8">
                    @if (Model.InactiveUsers.Count == 0)
                    {
                        <div class="rounded-[1.75rem] bg-slate-50 px-6 py-8 text-center text-sm text-slate-600">
                            Nenhum aluno foi encontrado sem check-in nesta faixa de dias.
                        </div>
                    }
                    else
                    {
                        @foreach (var user in Model.InactiveUsers.Take(8))
                        {
                            <article class="rounded-[1.5rem] border border-slate-200 px-5 py-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <h3 class="text-base font-semibold text-slate-900">@user.UserName</h3>
                                        <p class="mt-1 text-sm text-slate-500">@user.Email</p>
                                    </div>
                                    <span class="rounded-full tenant-soft-bg px-3 py-1 text-xs font-semibold text-slate-700">
                                        @user.DaysWithoutCheckInLabel
                                    </span>
                                </div>

                                <div class="mt-3 text-sm leading-6 text-slate-600">
                                    <p>Plano ativo: <strong class="text-slate-700">@(string.IsNullOrWhiteSpace(user.ActivePlanName) ? "Não informado" : user.ActivePlanName)</strong></p>
                                    <p>Último check-in: <strong class="text-slate-700">@user.LastCheckedInAt?.ToLocalTime().ToString("dd/MM/yyyy")</strong></p>
                                </div>
                            </article>
                        }
                    }
                </div>
            </section>
        </div>
    }
</section>
