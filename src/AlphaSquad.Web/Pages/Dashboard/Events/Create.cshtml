@page
@model AlphaSquad.Web.Pages.Dashboard.Events.CreateModel
@{
    ViewData["Title"] = "Novo Evento";
}

<section class="space-y-6" x-data="{ studentSearch: '' }">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Operação</li>
            <li><a asp-page="/Dashboard/Events/Index" class="hover:text-slate-700">Eventos</a></li>
            <li class="font-medium tenant-text">Novo evento</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Novo evento</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Cadastre a ação da academia, gere automaticamente a senha do check-in e já selecione os alunos que participarão do evento.
        </p>
    </div>

    <form method="post" enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,0.9fr)]">
        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Dados do evento</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Defina o conteúdo do mural, o período e se o evento aceitará participação com check-in por senha.
                </p>
            </div>

            <div class="space-y-6 px-6 py-6 sm:px-8">
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

                <div class="grid gap-5 lg:grid-cols-2">
                    <label class="form-control lg:col-span-2">
                        <span class="mb-2 text-sm font-medium text-slate-700">Título do evento</span>
                        <input asp-for="Input.Title" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        <span asp-validation-for="Input.Title" class="mt-2 text-sm text-rose-600"></span>
                    </label>

                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Localização</span>
                        <input asp-for="Input.Location" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                    </label>

                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Imagem de divulgação (opcional)</span>
                        <input asp-for="EventImage" type="file" accept="image/*" class="file-input file-input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        <span asp-validation-for="EventImage" class="mt-2 text-sm text-rose-600"></span>
                        <span class="mt-2 text-xs leading-5 text-slate-500">Envie a arte que será exibida no app para os alunos visualizarem o evento.</span>
                    </label>
                </div>

                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Descrição</span>
                    <textarea asp-for="Input.Description" rows="5" class="textarea textarea-bordered rounded-2xl border-slate-200 bg-white"></textarea>
                </label>

                <div class="grid gap-5 md:grid-cols-2">
                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Início</span>
                        <input asp-for="Input.StartsAt" type="datetime-local" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                    </label>
                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Término</span>
                        <input asp-for="Input.EndsAt" type="datetime-local" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                    </label>
                </div>

                <div class="grid gap-4 lg:grid-cols-3">
                    <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                        <input asp-for="Input.IsOutdoorEvent" class="checkbox checkbox-sm mt-1" />
                        <span class="text-sm leading-6 text-slate-600">
                            <span class="block text-base font-semibold text-slate-900">Evento outdoor</span>
                            Libera o evento para participação e pontuação da gamificação.
                        </span>
                    </label>

                    <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                        <input asp-for="Input.AllowParticipation" class="checkbox checkbox-sm mt-1" />
                        <span class="text-sm leading-6 text-slate-600">
                            <span class="block text-base font-semibold text-slate-900">Permitir participação</span>
                            Habilita matrícula e check-in por senha no aplicativo.
                        </span>
                    </label>

                    <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                        <input asp-for="Input.IsActive" class="checkbox checkbox-sm mt-1" />
                        <span class="text-sm leading-6 text-slate-600">
                            <span class="block text-base font-semibold text-slate-900">Publicar ativo</span>
                            Deixa o evento visível e pronto para uso assim que for salvo.
                        </span>
                    </label>
                </div>
            </div>
        </section>

        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Matrícula inicial</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Selecione os alunos que já devem sair inscritos no evento. A presença será confirmada depois, com a senha no app.
                </p>
            </div>

            <div class="space-y-5 px-6 py-6 sm:px-8">
                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Buscar aluno</span>
                    <input type="text"
                           x-model="studentSearch"
                           class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white"
                           placeholder="Pesquisar por nome ou e-mail" />
                </label>

                <div class="max-h-[28rem] space-y-3 overflow-y-auto pr-1">
                    @if (Model.Students.Any())
                    {
                        @foreach (var student in Model.Students)
                        {
                            <label x-show="'@student.Name.ToLowerInvariant() @student.Email.ToLowerInvariant()'.includes(studentSearch.toLowerCase())"
                                   class="flex cursor-pointer items-start gap-4 rounded-[1.25rem] border border-slate-200 px-4 py-4 transition hover:border-slate-300 hover:bg-slate-50">
                                <input type="checkbox"
                                       name="SelectedStudentIds"
                                       value="@student.Id"
                                       class="checkbox checkbox-sm mt-1"
                                       @(Model.SelectedStudentIds.Contains(student.Id) ? "checked" : null) />
                                <span class="min-w-0 text-sm leading-6 text-slate-600">
                                    <span class="block truncate text-base font-semibold text-slate-900">@student.Name</span>
                                    <span class="block truncate text-slate-500">@student.Email</span>
                                </span>
                            </label>
                        }
                    }
                    else
                    {
                        <div class="rounded-[1.25rem] border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
                            Nenhum aluno ativo foi encontrado para matrícula.
                        </div>
                    }
                </div>
            </div>
        </section>

        <div class="flex flex-col gap-3 border-t border-slate-200 pt-1 sm:flex-row sm:justify-between xl:col-span-2">
            <a asp-page="/Dashboard/Events/Index"
               class="rounded-full border border-slate-200 bg-white px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                Voltar ao mural
            </a>
            <button type="submit"
                    class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                    style="background: var(--tenant-primary);">
                Criar evento
            </button>
        </div>
    </form>

    <partial name="_ValidationScriptsPartial" />
</section>
