@page "{id:guid}"
@model AlphaSquad.Web.Pages.Dashboard.Events.EditModel
@{
    ViewData["Title"] = "Editar evento";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Operação</li>
            <li><a asp-page="/Dashboard/Events/Index" class="hover:text-slate-700">Eventos</a></li>
            <li class="font-medium tenant-text">Editar evento</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Editar evento</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Ajuste os dados da ação, acompanhe a senha do check-in e finalize o evento quando as presenças já tiverem sido confirmadas.
        </p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <h2 class="text-xl font-semibold tenant-text">Dados do evento</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-500">
                        Eventos concluídos continuam visíveis para consulta, mas não podem voltar ao fluxo ativo de check-in e pontuação.
                    </p>
                </div>

                <form method="post" class="space-y-6 px-6 py-6 sm:px-8">
                    <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

                    <div class="grid gap-5 lg:grid-cols-2">
                        <label class="form-control lg:col-span-2">
                            <span class="mb-2 text-sm font-medium text-slate-700">Título do evento</span>
                            <input asp-for="Input.Title" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                            <span asp-validation-for="Input.Title" class="mt-2 text-sm text-rose-600"></span>
                        </label>

                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Localização</span>
                            <input asp-for="Input.Location" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>

                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Id da mídia (opcional)</span>
                            <input asp-for="Input.MediaId" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>
                    </div>

                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Descrição</span>
                        <textarea asp-for="Input.Description" rows="5" class="textarea textarea-bordered rounded-2xl border-slate-200 bg-white"></textarea>
                    </label>

                    <div class="grid gap-5 md:grid-cols-2">
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Início</span>
                            <input asp-for="Input.StartsAt" type="datetime-local" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Término</span>
                            <input asp-for="Input.EndsAt" type="datetime-local" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-3">
                        <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                            <input asp-for="Input.IsOutdoorEvent" class="checkbox checkbox-sm mt-1" />
                            <span class="text-sm leading-6 text-slate-600">
                                <span class="block text-base font-semibold text-slate-900">Evento outdoor</span>
                                Mantém o evento elegível para participação e gamificação.
                            </span>
                        </label>

                        <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                            <input asp-for="Input.AllowParticipation" class="checkbox checkbox-sm mt-1" />
                            <span class="text-sm leading-6 text-slate-600">
                                <span class="block text-base font-semibold text-slate-900">Permitir participação</span>
                                Libera matrícula e check-in por senha no aplicativo.
                            </span>
                        </label>

                        <label class="flex items-start gap-4 rounded-[1.5rem] border border-slate-200 px-5 py-4">
                            <input asp-for="Input.IsActive" class="checkbox checkbox-sm mt-1" disabled="@Model.IsCompleted" />
                            <span class="text-sm leading-6 text-slate-600">
                                <span class="block text-base font-semibold text-slate-900">Evento ativo</span>
                                @if (Model.IsCompleted)
                                {
                                    <span>Eventos concluídos permanecem inativos de forma definitiva.</span>
                                }
                                else
                                {
                                    <span>Controla se o evento está disponível para matrícula e check-in.</span>
                                }
                            </span>
                        </label>
                    </div>

                    <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-between">
                        <a asp-page="/Dashboard/Events/Index"
                           class="rounded-full border border-slate-200 bg-white px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                            Voltar ao mural
                        </a>
                        <button type="submit"
                                class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                style="background: var(--tenant-primary);">
                            Salvar alterações
                        </button>
                    </div>
                </form>
            </section>

            <section class="space-y-6">
                <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Operação do evento</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Use estes blocos para divulgar a senha, validar o estado do evento e executar os atalhos administrativos.
                        </p>
                    </div>

                    <div class="space-y-5 px-6 py-6 sm:px-8">
                        <div class="grid gap-4">
                            <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                                <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Senha do check-in</p>
                                <p class="mt-3 text-3xl font-semibold tenant-text">@Model.CheckInPassword</p>
                                <p class="mt-2 text-sm leading-6 text-slate-500">
                                    Divulgue esta senha no dia do evento para que os alunos confirmem presença no aplicativo.
                                </p>
                            </div>

                            <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                                <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Status atual</p>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <span class="rounded-full px-3 py-1 text-xs font-semibold @(Model.IsCompleted ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700")">
                                        @(Model.IsCompleted ? "Concluído" : "Em operação")
                                    </span>
                                    @if (Model.Input.IsOutdoorEvent)
                                    {
                                        <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">Outdoor</span>
                                    }
                                    @if (Model.Input.AllowParticipation)
                                    {
                                        <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700">Com inscrição</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.CurrentMediaUrl))
                        {
                            <img src="@Model.CurrentMediaUrl" alt="Mídia do evento" class="w-full rounded-[1.5rem] border border-slate-200 object-cover shadow-sm" />
                        }
                    </div>
                </article>

                <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Atalhos administrativos</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Conclua o evento quando os check-ins já estiverem feitos ou remova-o antes do início.
                        </p>
                    </div>

                    <div class="flex flex-col gap-3 px-6 py-6 sm:px-8">
                        <a asp-page="/Dashboard/Events/Enrollment"
                           asp-route-id="@Model.EventId"
                           class="rounded-full border border-slate-200 bg-white px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                            Gerenciar inscrições
                        </a>

                        @if (Model.CanComplete)
                        {
                            <form method="post" asp-page-handler="Complete" asp-route-id="@Model.EventId">
                                <button type="submit"
                                        class="w-full rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                        style="background: var(--tenant-primary);"
                                        onclick="return confirm('Deseja concluir este evento e distribuir os pontos para os presentes?');">
                                    Concluir evento
                                </button>
                            </form>
                        }

                        @if (Model.CanDeletePhysically)
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.EventId">
                                <button type="submit"
                                        class="w-full rounded-full border border-rose-200 bg-rose-50 px-6 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-100"
                                        onclick="return confirm('Deseja remover este evento de forma definitiva?');">
                                    Remover evento
                                </button>
                            </form>
                        }
                    </div>
                </article>
            </section>
        </div>

    <partial name="_ValidationScriptsPartial" />
</section>
