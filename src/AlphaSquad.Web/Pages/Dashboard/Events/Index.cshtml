@page
@model AlphaSquad.Web.Pages.Dashboard.Events.IndexModel
@{
    ViewData["Title"] = "Eventos";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Operação</li>
            <li class="font-medium tenant-text">Eventos</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Eventos</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Organize o mural da academia, acompanhe inscrições e conclua eventos outdoor com distribuição segura dos pontos da gamificação.
        </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Total de eventos</p>
            <p class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalEvents</p>
            <p class="mt-3 text-sm leading-6 text-slate-500">Quantidade de eventos retornados com os filtros atuais.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Outdoor</p>
            <p class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalOutdoor</p>
            <p class="mt-3 text-sm leading-6 text-slate-500">Eventos aptos para matrícula, check-in por senha e pontuação.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Inscrições</p>
            <p class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalEnrolled</p>
            <p class="mt-3 text-sm leading-6 text-slate-500">Soma dos alunos inscritos nas ações listadas abaixo.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Concluídos</p>
            <p class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalCompleted</p>
            <p class="mt-3 text-sm leading-6 text-slate-500">Eventos já encerrados com processamento de presença e gamificação.</p>
        </article>
    </div>

    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
        <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-start sm:justify-between sm:px-8">
            <div>
                <h2 class="text-xl font-semibold tenant-text">Mural da academia</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Filtre por título e status, abra o detalhe do evento e use os atalhos para inscrições, conclusão e remoção.
                </p>
            </div>
            <a asp-page="/Dashboard/Events/Create"
               class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
               style="background: var(--tenant-primary);">
                Novo evento
            </a>
        </div>

        <form method="get" class="grid gap-4 border-b border-slate-200 px-6 py-5 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:px-8">
            <label class="form-control">
                <span class="mb-2 text-sm font-medium text-slate-700">Pesquisar</span>
                <input asp-for="Search" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="Buscar por título ou local" />
            </label>

            <label class="flex items-center gap-3 rounded-[1.25rem] border border-slate-200 px-4 py-3 sm:mt-7">
                <input asp-for="IncludeInactive" class="checkbox checkbox-sm" />
                <span class="text-sm font-medium text-slate-700">Incluir inativos e concluídos</span>
            </label>

            <div class="flex items-end gap-3 sm:justify-end">
                <button type="submit"
                        class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                        style="background: var(--tenant-primary);">
                    Aplicar
                </button>
                <a asp-page="/Dashboard/Events/Index"
                   class="rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                    Limpar
                </a>
            </div>
        </form>

        <div class="px-6 py-6 sm:px-8">
            @if (Model.Events.Any())
            {
                <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                    <article class="flex min-h-[22rem] flex-col items-center justify-center rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center">
                        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-slate-400 shadow-sm">
                            <span class="material-symbols-rounded text-3xl">add_circle</span>
                        </div>
                        <h3 class="mt-5 text-lg font-semibold text-slate-900">Novo evento</h3>
                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            Crie um novo evento, gere a senha de check-in e já matricule os alunos que participarão da ação.
                        </p>
                        <a asp-page="/Dashboard/Events/Create"
                           class="mt-6 rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                           style="background: var(--tenant-primary);">
                            Criar agora
                        </a>
                    </article>

                    @foreach (var ev in Model.Events)
                    {
                        <article class="flex flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/50">
                            <div class="aspect-[4/3] overflow-hidden bg-slate-100">
                                @if (!string.IsNullOrWhiteSpace(ev.MediaUrl))
                                {
                                    <img src="@ev.MediaUrl" alt="@ev.Title" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center text-slate-300">
                                        <span class="material-symbols-rounded text-6xl">event</span>
                                    </div>
                                }
                            </div>

                            <div class="flex flex-1 flex-col gap-4 p-5">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="rounded-full px-3 py-1 text-xs font-semibold @ev.StatusToneClass">@ev.StatusLabel</span>
                                    @if (ev.IsOutdoorEvent)
                                    {
                                        <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">Outdoor</span>
                                    }
                                    @if (ev.AllowParticipation)
                                    {
                                        <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700">Com inscrição</span>
                                    }
                                </div>

                                <div class="space-y-2">
                                    <h3 class="text-lg font-semibold text-slate-900">@ev.Title</h3>
                                    <p class="line-clamp-3 text-sm leading-6 text-slate-500">@(string.IsNullOrWhiteSpace(ev.Description) ? "Sem descrição cadastrada." : ev.Description)</p>
                                </div>

                                <dl class="grid gap-3 text-sm text-slate-500">
                                    <div class="flex items-center justify-between gap-4">
                                        <dt>Início</dt>
                                        <dd class="font-medium text-slate-700">@(ev.StartsAt?.ToString("dd/MM/yyyy HH:mm") ?? "Não informado")</dd>
                                    </div>
                                    <div class="flex items-center justify-between gap-4">
                                        <dt>Local</dt>
                                        <dd class="font-medium text-slate-700">@(string.IsNullOrWhiteSpace(ev.Location) ? "Não informado" : ev.Location)</dd>
                                    </div>
                                    <div class="flex items-center justify-between gap-4">
                                        <dt>Inscritos</dt>
                                        <dd class="font-medium text-slate-700">@ev.ParticipantCount</dd>
                                    </div>
                                </dl>

                                <div class="mt-auto flex flex-wrap gap-3 pt-2">
                                    <a asp-page="/Dashboard/Events/Edit"
                                       asp-route-id="@ev.Id"
                                       class="rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                                        Editar
                                    </a>
                                    <a asp-page="/Dashboard/Events/Enrollment"
                                       asp-route-id="@ev.Id"
                                       class="rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                                        Inscrições
                                    </a>

                                    @if (ev.CanDeletePhysically)
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@ev.Id" class="contents">
                                            <button type="submit"
                                                    class="rounded-full border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100"
                                                    onclick="return confirm('Deseja remover este evento de forma definitiva?');">
                                                Remover
                                            </button>
                                        </form>
                                    }
                                    else if (ev.CanComplete)
                                    {
                                        <form method="post" asp-page-handler="Complete" asp-route-id="@ev.Id" class="contents">
                                            <button type="submit"
                                                    class="rounded-full px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                                    style="background: var(--tenant-primary);"
                                                    onclick="return confirm('Deseja concluir este evento e distribuir os pontos para os presentes?');">
                                                Concluir evento
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-slate-400 shadow-sm">
                        <span class="material-symbols-rounded text-3xl">event_busy</span>
                    </div>
                    <h3 class="mt-5 text-lg font-semibold text-slate-900">Nenhum evento encontrado</h3>
                    <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
                        Ajuste os filtros ou crie um novo evento para começar a organizar inscrições, presença e pontuação.
                    </p>
                </div>
            }
        </div>
    </section>
</section>
