@page
@model AlphaSquad.Web.Pages.Dashboard.Classes.IndexModel
@{
    ViewData["Title"] = "Aulas";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Operação</li>
            <li class="font-medium tenant-text">Aulas</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Agenda e ocupação das aulas</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Acompanhe a grade de turmas, identifique aulões, monitore a ocupação e tenha uma leitura rápida das reservas recentes da academia.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-800">
            @Model.SuccessMessage
        </div>
    }

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Turmas listadas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalClasses</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Quantidade de aulas encontradas com os filtros atuais.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Aulas ativas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.ActiveClasses</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Turmas disponíveis para operação regular da academia.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Aulões</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.SpecialClasses</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Aulas especiais em destaque para engajamento e eventos internos.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Reservas</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.TotalReservations</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Soma das vagas já reservadas nas turmas retornadas pela consulta.</p>
        </article>
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Ocupação média</p>
            <h2 class="mt-4 text-4xl font-semibold tenant-text">@Model.AverageOccupancy.ToString("0.#")%</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Leitura rápida da taxa média de preenchimento das turmas carregadas.</p>
        </article>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-700">
            @Model.LoadErrorMessage
        </div>
    }
    else
    {
        <div class="space-y-6">
            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
                    <div>
                        <h2 class="text-xl font-semibold tenant-text">Grade de aulas</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Filtre a agenda, acompanhe ocupação, identifique aulões e mantenha a operação das turmas em uma única visão.
                        </p>
                    </div>
                    @if (Model.CanManageClasses)
                    {
                        <a asp-page="/Dashboard/Classes/Create"
                           class="rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                           style="background: var(--tenant-primary);">
                            Nova aula
                        </a>
                    }
                </div>

                <div class="border-b border-slate-200 bg-slate-50/80 px-6 py-5 sm:px-8">
                    <form method="get" class="grid gap-4 xl:grid-cols-[1.2fr_0.85fr_0.85fr_0.85fr_auto] xl:items-end">
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Pesquisar</span>
                            <input asp-for="Search" type="text" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="Nome, local ou instrutor" />
                        </label>
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">De</span>
                            <input asp-for="DateFrom" type="date" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Até</span>
                            <input asp-for="DateTo" type="date" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" />
                        </label>
                        <label class="form-control">
                            <span class="mb-2 text-sm font-medium text-slate-700">Status</span>
                            <select asp-for="IsActive" class="select select-bordered h-12 rounded-2xl border-slate-200 bg-white">
                                <option value="">Todas</option>
                                <option value="true">Apenas ativas</option>
                                <option value="false">Apenas inativas</option>
                            </select>
                        </label>
                        <div class="flex flex-wrap items-end gap-3">
                            <label class="flex flex-1 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 xl:min-w-52">
                                <input asp-for="OnlySpecialClasses" type="checkbox" class="checkbox checkbox-sm rounded-md border-slate-300" />
                                <span>Apenas aulões</span>
                            </label>
                            <button type="submit"
                                    class="rounded-full px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                    style="background: var(--tenant-primary);">
                                Filtrar
                            </button>
                        </div>
                    </form>
                </div>

                @if (Model.Classes.Count == 0)
                {
                    <div class="px-6 py-10 text-center sm:px-8">
                        <div class="tenant-soft-bg mx-auto max-w-xl rounded-[1.75rem] border tenant-soft-border px-8 py-10">
                            <p class="text-base font-medium text-slate-700">
                                Nenhuma aula foi encontrada com os filtros informados.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr class="text-slate-500">
                                    <th>Turma</th>
                                    <th>Instrutor</th>
                                    <th>Horário</th>
                                    <th>Local</th>
                                    <th>Ocupação</th>
                                    <th>Status</th>
                                    <th class="text-right">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Classes)
                                {
                                    <tr class="hover">
                                        <td>
                                            <div class="font-semibold text-slate-900">@item.Name</div>
                                            <div class="mt-1 text-sm text-slate-500">@item.Description</div>
                                            <div class="mt-2 flex flex-wrap gap-2">
                                                <span class="rounded-full @(item.IsSpecialClass ? "bg-amber-50 text-amber-700" : "bg-slate-100 text-slate-600") px-3 py-1 text-xs font-semibold">
                                                    @item.SpecialClassLabel
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-slate-600">@item.InstructorName</td>
                                        <td class="text-slate-600">@item.ScheduleLabel</td>
                                        <td class="text-slate-600">@item.Location</td>
                                        <td>
                                            <div class="min-w-44">
                                                <div class="mb-2 flex items-center justify-between text-xs font-medium text-slate-500">
                                                    <span>@item.OccupancyLabel</span>
                                                    <span>@item.OccupancyRate.ToString("0.#")%</span>
                                                </div>
                                                <progress class="progress h-2 w-full" value="@item.OccupancyRate" max="100"></progress>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="rounded-full px-3 py-1 text-xs font-semibold @(item.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                                                @item.StatusLabel
                                            </span>
                                        </td>
                                        <td>
                                            <div class="flex justify-end gap-2">
                                                <a asp-page="/Dashboard/Classes/Details"
                                                   asp-route-id="@item.Id"
                                                   class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                                                    Ver
                                                </a>

                                                @if (Model.CanManageClasses)
                                                {
                                                    <a asp-page="/Dashboard/Classes/Edit"
                                                       asp-route-id="@item.Id"
                                                       class="rounded-full px-4 py-2 text-xs font-semibold text-white transition hover:brightness-95"
                                                       style="background: var(--tenant-primary);">
                                                        Editar
                                                    </a>

                                                    <form method="post"
                                                          asp-page-handler="Delete"
                                                          asp-route-id="@item.Id"
                                                          onsubmit="return confirm('Deseja realmente remover esta aula?');">
                                                        <button type="submit"
                                                                class="rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100">
                                                            Excluir
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <div class="grid gap-6 xl:grid-cols-2">
                <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Turmas com maior ocupação</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Um recorte das aulas que hoje estão aproveitando melhor as vagas disponíveis.
                        </p>
                    </div>

                    <div class="space-y-4 px-6 py-6 sm:px-8">
                        @if (Model.TopOccupiedClasses.Count == 0)
                        {
                            <div class="rounded-[1.75rem] bg-slate-50 px-6 py-8 text-center text-sm text-slate-600">
                                Ainda não há dados suficientes para destacar ocupação.
                            </div>
                        }
                        else
                        {
                            @foreach (var item in Model.TopOccupiedClasses)
                            {
                                <article class="rounded-[1.5rem] border border-slate-200 px-5 py-4">
                                    <div class="flex items-start justify-between gap-4">
                                        <div>
                                            <h3 class="text-base font-semibold text-slate-900">@item.Name</h3>
                                            <p class="mt-1 text-sm text-slate-500">@item.ScheduleLabel</p>
                                        </div>
                                        <span class="rounded-full tenant-soft-bg px-3 py-1 text-xs font-semibold text-slate-700">
                                            @item.OccupancyRate.ToString("0.#")%
                                        </span>
                                    </div>
                                    <div class="mt-3 text-sm leading-6 text-slate-600">
                                        <p>Instrutor: <strong class="text-slate-700">@item.InstructorName</strong></p>
                                        <p>Ocupação: <strong class="text-slate-700">@item.OccupancyLabel</strong></p>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                    <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                        <h2 class="text-xl font-semibold tenant-text">Reservas recentes</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Últimas confirmações de alunos nas turmas consultadas, úteis para recepção e acompanhamento do dia.
                        </p>
                    </div>

                    <div class="space-y-4 px-6 py-6 sm:px-8">
                        @if (Model.RecentBookings.Count == 0)
                        {
                            <div class="rounded-[1.75rem] bg-slate-50 px-6 py-8 text-center text-sm text-slate-600">
                                Ainda não há reservas recentes para exibir.
                            </div>
                        }
                        else
                        {
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <article class="rounded-[1.5rem] border border-slate-200 px-5 py-4">
                                    <div class="flex items-start justify-between gap-4">
                                        <div>
                                            <h3 class="text-base font-semibold text-slate-900">@booking.UserName</h3>
                                            <p class="mt-1 text-sm text-slate-500">@booking.UserEmail</p>
                                        </div>
                                        <span class="rounded-full @(booking.IsSpecialClass ? "bg-amber-50 text-amber-700" : "bg-slate-100 text-slate-600") px-3 py-1 text-xs font-semibold">
                                            @(booking.IsSpecialClass ? "Aulão" : booking.UserRoleLabel)
                                        </span>
                                    </div>
                                    <div class="mt-3 text-sm leading-6 text-slate-600">
                                        <p>Turma: <strong class="text-slate-700">@booking.ClassName</strong></p>
                                        <p>Horário: <strong class="text-slate-700">@booking.ScheduleLabel</strong></p>
                                        <p>Reserva feita em: <strong class="text-slate-700">@booking.BookedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></p>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>
            </div>
        </div>
    }
</section>
