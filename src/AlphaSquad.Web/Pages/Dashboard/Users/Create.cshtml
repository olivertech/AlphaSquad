@page
@model AlphaSquad.Web.Pages.Dashboard.Users.CreateModel
@{
    ViewData["Title"] = "Novo usuário";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li>Gestão</li>
            <li><a asp-page="/Dashboard/Users/Index" class="hover:text-slate-700">Usuários</a></li>
            <li class="font-medium tenant-text">Novo usuário</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Cadastrar usuário</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Crie um novo perfil para administração, professores ou alunos com uma linguagem simples e objetiva.
        </p>
    </div>

    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
        <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
            <h2 class="text-xl font-semibold tenant-text">Dados do novo usuário</h2>
            <p class="mt-1 text-sm leading-6 text-slate-500">
                Preencha os dados abaixo para liberar o acesso do novo usuário ao ecossistema da academia.
            </p>
        </div>

        <form method="post" class="space-y-6 px-6 py-6 sm:px-8">
            <div class="grid gap-5 lg:grid-cols-2">
                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Nome completo</span>
                    <input asp-for="Input.Name" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="Ex.: Marina Costa" />
                    <span asp-validation-for="Input.Name" class="mt-2 text-sm text-rose-600"></span>
                </label>

                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">E-mail</span>
                    <input asp-for="Input.Email" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="nome@academia.com" />
                    <span asp-validation-for="Input.Email" class="mt-2 text-sm text-rose-600"></span>
                </label>
            </div>

            <div class="grid gap-5 lg:grid-cols-2">
                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Senha inicial</span>
                    <input asp-for="Input.Password" type="password" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="Defina uma senha inicial" />
                    <span asp-validation-for="Input.Password" class="mt-2 text-sm text-rose-600"></span>
                </label>

                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Perfil</span>
                    <select asp-for="Input.Role" class="select select-bordered h-12 rounded-2xl border-slate-200 bg-white">
                        <option value="">Selecione um perfil</option>
                        @foreach (var roleOption in Model.RoleOptions)
                        {
                            <option value="@roleOption.Value">@roleOption.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Role" class="mt-2 text-sm text-rose-600"></span>
                </label>
            </div>

            <div class="grid gap-5 lg:grid-cols-2">
                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Celular com DDD</span>
                    <input asp-for="Input.PhoneNumber" inputmode="numeric" maxlength="15" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="(11) 99999-9999" />
                    <span asp-validation-for="Input.PhoneNumber" class="mt-2 text-sm text-rose-600"></span>
                </label>

                <label class="form-control">
                    <span class="mb-2 text-sm font-medium text-slate-700">Data de nascimento</span>
                    <input asp-for="Input.BirthDate" inputmode="numeric" maxlength="10" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="dd/mm/aaaa" />
                    <span asp-validation-for="Input.BirthDate" class="mt-2 text-sm text-rose-600"></span>
                </label>
            </div>

            <section id="membershipSection" class="space-y-4 rounded-[1.75rem] border border-slate-200 bg-slate-50/70 p-5 hidden">
                <div class="space-y-1">
                    <h3 class="text-base font-semibold tenant-text">Plano do aluno</h3>
                    <p class="text-sm leading-6 text-slate-500">
                        Para alunos, você já pode definir o plano ativo e o dia base de vencimento da mensalidade.
                    </p>
                </div>

                <div class="grid gap-5 lg:grid-cols-[1.4fr_0.6fr]">
                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Plano contratado</span>
                        <select asp-for="Input.MembershipPlanId" class="select select-bordered h-12 rounded-2xl border-slate-200 bg-white">
                            <option value="">Sem plano ativo</option>
                            @foreach (var plan in Model.MembershipPlanOptions)
                            {
                                <option value="@plan.Id">@plan.Label</option>
                            }
                        </select>
                        <span asp-validation-for="Input.MembershipPlanId" class="mt-2 text-sm text-rose-600"></span>
                    </label>

                    <label class="form-control">
                        <span class="mb-2 text-sm font-medium text-slate-700">Dia de vencimento</span>
                        <input asp-for="Input.MembershipBillingDueDay" type="number" min="1" max="31" class="input input-bordered h-12 rounded-2xl border-slate-200 bg-white" placeholder="Ex.: 10" />
                        <span asp-validation-for="Input.MembershipBillingDueDay" class="mt-2 text-sm text-rose-600"></span>
                    </label>
                </div>
            </section>

            <div class="grid gap-4 lg:grid-cols-3">
                @foreach (var roleOption in Model.RoleOptions)
                {
                    var isSelected = Model.Input.Role == roleOption.Value;
                    <label class="cursor-pointer rounded-[1.5rem] border px-5 py-4 transition @(isSelected ? "tenant-soft-bg tenant-soft-border" : "border-slate-200 hover:border-slate-300 hover:bg-slate-50")">
                        <input asp-for="Input.Role" type="radio" value="@roleOption.Value" class="sr-only" />
                        <span class="text-base font-semibold text-slate-900">@roleOption.Label</span>
                        <span class="mt-2 block text-sm leading-6 text-slate-500">@roleOption.Description</span>
                    </label>
                }
            </div>

            <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
                <a asp-page="/Dashboard/Users/Index"
                   class="rounded-full border border-slate-200 bg-white px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                    Cancelar
                </a>
                <button type="submit"
                        class="rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                        style="background: var(--tenant-primary);">
                    Salvar usuário
                </button>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function formatPhoneNumber(value) {
            const digits = value.replace(/\D/g, '').slice(0, 11);

            if (digits.length <= 2) {
                return digits.length ? `(${digits}` : '';
            }

            if (digits.length <= 6) {
                return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
            }

            if (digits.length <= 10) {
                return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
            }

            return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
        }

        function formatBirthDate(value) {
            const digits = value.replace(/\D/g, '').slice(0, 8);

            if (digits.length <= 2) {
                return digits;
            }

            if (digits.length <= 4) {
                return `${digits.slice(0, 2)}/${digits.slice(2)}`;
            }

            return `${digits.slice(0, 2)}/${digits.slice(2, 4)}/${digits.slice(4)}`;
        }

        function syncMembershipSection() {
            const roleInput = document.getElementById('Input_Role');
            const membershipSection = document.getElementById('membershipSection');
            const dueDayInput = document.getElementById('Input_MembershipBillingDueDay');
            const planInput = document.getElementById('Input_MembershipPlanId');

            if (!roleInput || !membershipSection) {
                return;
            }

            const isStudent = roleInput.value === '3';
            membershipSection.classList.toggle('hidden', !isStudent);

            if (!isStudent) {
                if (planInput) {
                    planInput.value = '';
                }

                if (dueDayInput) {
                    dueDayInput.value = '';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const phoneInput = document.getElementById('Input_PhoneNumber');
            const birthDateInput = document.getElementById('Input_BirthDate');
            const roleInput = document.getElementById('Input_Role');
            const roleRadios = document.querySelectorAll('input[name="Input.Role"]');

            if (phoneInput) {
                phoneInput.value = formatPhoneNumber(phoneInput.value ?? '');
                phoneInput.addEventListener('input', (event) => {
                    event.target.value = formatPhoneNumber(event.target.value ?? '');
                });
            }

            if (birthDateInput) {
                birthDateInput.addEventListener('input', (event) => {
                    event.target.value = formatBirthDate(event.target.value ?? '');
                });
            }

            if (roleInput) {
                roleInput.addEventListener('change', syncMembershipSection);
            }

            roleRadios.forEach((radio) => {
                radio.addEventListener('change', syncMembershipSection);
            });

            syncMembershipSection();
        });
    </script>
}
