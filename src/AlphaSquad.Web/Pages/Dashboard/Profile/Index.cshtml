@page
@model AlphaSquad.Web.Pages.Dashboard.Profile.IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<section class="space-y-6">
    @* Navegação Breadcrumb para manter a consistência do Dashboard *@
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li class="font-medium tenant-text">Meu Perfil</li>
        </ul>
    </nav>

    @* Cabeçalho da página com título e subtítulo *@
    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Meu Perfil</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Confira seus dados e gerencie as configurações da sua conta.
        </p>
    </div>

    @if (Model.Profile is not null)
    {
        @* Card Único e Unificado *@
        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
            <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-semibold tenant-text">Visão Geral</h2>
                <p class="mt-1 text-sm leading-6 text-slate-500">
                    Informações vinculadas ao seu acesso no sistema.
                </p>
            </div>

            <div class="p-6 sm:px-8 py-8">
                <div class="flex flex-col md:flex-row items-center gap-8">
                    @* Avatar do Usuário *@
                    <div class="relative">
                        @if (!string.IsNullOrEmpty(Model.Profile.PhotoUrl))
                        {
                            <img src="@Model.Profile.PhotoUrl"
                                 alt="Foto de Perfil"
                                 class="h-32 w-32 rounded-full object-cover border-4 border-slate-100 shadow-md" />
                        }
                        else
                        {
                            <div class="flex h-32 w-32 items-center justify-center rounded-full text-4xl font-semibold text-white shadow-md"
                                 style="background: var(--tenant-primary);">
                                @Model.Profile.Initials
                            </div>
                        }
                    </div>

                    @* Detalhes e Ação *@
                    <div class="flex-1 text-center md:text-left space-y-6">
                        <div class="space-y-1">
                            <h3 class="text-3xl font-bold text-slate-950">@Model.Profile.Name</h3>
                            <p class="text-lg text-slate-500">@Model.Profile.Email</p>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2 max-w-2xl">
                            <article class="rounded-[1.5rem] border border-slate-200 p-4">
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Identificação</p>
                                <p class="mt-2 text-base font-medium text-slate-900">@Model.Profile.Name</p>
                            </article>
                            <article class="rounded-[1.5rem] bg-slate-50 p-4">
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Contato</p>
                                <p class="mt-2 text-base font-medium text-slate-900">@Model.Profile.Email</p>
                            </article>
                        </div>

                        <div class="flex justify-center md:justify-start pt-4">
                            <a asp-page="/Dashboard/Profile/Manage"
                                   class="rounded-full px-8 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-95"
                                   style="background: var(--tenant-primary);">
                                Gerenciar Perfil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (Model.LoadErrorMessage is not null)
    {
        <div class="rounded-[2rem] border border-rose-200 bg-rose-50 p-6 text-center">
            <p class="text-rose-700 font-medium">@Model.LoadErrorMessage</p>
            <a asp-page="/Dashboard/Profile/Index" class="mt-4 inline-block rounded-full bg-rose-600 px-6 py-2 text-sm font-semibold text-white transition hover:brightness-95">
                Tentar Novamente
            </a>
        </div>
    }
</section>
