@page
@model AlphaSquad.Web.Pages.Dashboard.Profile.IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<section class="space-y-6">
    <nav class="breadcrumbs px-1 text-sm text-slate-500">
        <ul>
            <li><a asp-page="/Dashboard/Index" class="hover:text-slate-700">Dashboard</a></li>
            <li class="font-medium tenant-text">Meu Perfil</li>
        </ul>
    </nav>

    <div class="space-y-2 px-1">
        <h1 class="text-3xl font-semibold tracking-tight tenant-text">Meu Perfil</h1>
        <p class="max-w-3xl text-sm leading-7 text-slate-500">
            Gerencie suas informações pessoais, atualize sua foto e controle as configurações de segurança da sua conta.
        </p>
    </div>

    @if (Model.Profile is not null)
    {
        <div class="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <h2 class="text-xl font-semibold tenant-text">Visão Geral</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-500">
                        Confira como seus dados estão registrados no sistema.
                    </p>
                </div>

                <div class="space-y-6 px-6 py-6 sm:px-8">
                    <div class="flex items-center gap-5">
                        <div class="relative">
                            @if (!string.IsNullOrEmpty(Model.Profile.PhotoUrl))
                            {
                                <img src="@Model.Profile.PhotoUrl" 
                                     alt="Foto de Perfil" 
                                     class="h-20 w-20 rounded-full object-cover border-2 border-slate-100 shadow-sm" />
                            }
                            else
                            {
                                <div class="flex h-20 w-20 items-center justify-center rounded-full text-2xl font-semibold text-white"
                                     style="background: var(--tenant-primary);">
                                    @Model.Profile.Initials
                                </div>
                            }
                        </div>
                        <div>
                            <h3 class="text-2xl font-semibold text-slate-950">@Model.Profile.Name</h3>
                            <p class="mt-1 text-sm text-slate-500">@Model.Profile.Email</p>
                        </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        <article class="rounded-[1.5rem] border border-slate-200 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Identificação</p>
                            <h4 class="mt-3 text-lg font-semibold text-slate-950">@Model.Profile.Name</h4>
                            <p class="mt-2 text-sm leading-6 text-slate-600">Nome principal vinculado ao cadastro.</p>
                        </article>
                        <article class="rounded-[1.5rem] bg-slate-50 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Contato</p>
                            <h4 class="mt-3 text-lg font-semibold text-slate-950">@Model.Profile.Email</h4>
                            <p class="mt-2 text-sm leading-6 text-slate-600">E-mail utilizado para login e notificações.</p>
                        </article>
                    </div>
                </div>
            </section>

            <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm shadow-slate-200/70">
                <div class="border-b border-slate-200 px-6 py-5 sm:px-8">
                    <h2 class="text-xl font-semibold tenant-text">Gerenciamento</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-500">
                        Acesse a área de edição para manter seu cadastro atualizado.
                    </p>
                </div>

                <div class="space-y-5 px-6 py-6 sm:px-8">
                    <a asp-page="/Dashboard/Profile/Manage" 
                       class="flex items-center justify-between rounded-2xl border border-slate-200 p-5 transition hover:border-slate-300 hover:bg-slate-50">
                        <div class="flex items-center gap-4">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-white hover:text-slate-900">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.asad-2.C-1.5 17a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5a2 2 0 012.036 2.036L17.232 11H13m4-6l-4 4" />
                                </svg>
                            </div>
                            <div class="text-left">
                                <span class="block text-base font-semibold text-slate-900">Gerenciar Perfil</span>
                                <span class="text-sm text-slate-500">Edite seus dados, senha e foto de perfil.</span>
                            </div>
                        </div>
                        <span class="text-slate-400 transition group-hover:text-slate-600">&rarr;</span>
                    </a>
                </div>
            </section>
        </div>
    }
    else if (Model.LoadErrorMessage is not null)
    {
        <div class="rounded-[2rem] border border-rose-200 bg-rose-50 p-6 text-center">
            <p class="text-rose-700 font-medium">@Model.LoadErrorMessage</p>
            <a asp-page="/Dashboard/Profile/Index" class="mt-4 inline-block rounded-full bg-rose-600 px-6 py-2 text-sm font-semibold text-white transition hover:brightness-95">
                Tentar Novamente
            </a>
        </div>
    }
</section>
