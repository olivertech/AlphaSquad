@using AlphaSquad.Web.Navigation
@using AlphaSquad.Web.Security
@inject IDashboardNavigationService NavigationService
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlphaSquad</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.24/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["Plus Jakarta Sans", "ui-sans-serif", "system-ui"]
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlphaSquad.Web.styles.css" asp-append-version="true" />
</head>
<body class="font-sans text-slate-900">
    @{
        var session = Context.Session.GetDashboardSession();
        var tenantName = session?.TenantName ?? "AlphaSquad";
        var userName = session?.Name ?? User.Identity?.Name ?? "Gestão";
        var role = session?.Role ?? string.Empty;
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        var primaryColor = string.IsNullOrWhiteSpace(session?.PrimaryColor) ? "#14b8a6" : session!.PrimaryColor;
        var secondaryColor = string.IsNullOrWhiteSpace(session?.SecondaryColor) ? "#475569" : session!.SecondaryColor;
        var menuSections = NavigationService.Build(session);
        var userInitials = string.Concat(
            (userName ?? "A")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
    }

    <div x-data="{ sidebarOpen: false, sidebarCompact: false }"
         class="min-h-screen bg-[#eef2f6]"
         style="--tenant-primary:@primaryColor; --tenant-secondary:@secondaryColor;">
        <div x-show="sidebarOpen"
             x-transition.opacity
             class="fixed inset-0 z-30 bg-slate-950/50 lg:hidden"
             @@click="sidebarOpen = false"></div>

        <aside class="fixed inset-y-0 left-0 z-40 flex bg-[#20252d] text-slate-200 transition-all duration-300"
               :class="[sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0', sidebarCompact ? 'lg:w-24' : 'lg:w-72']">
            <div class="flex w-full flex-col">
                <div class="flex h-24 items-center gap-4 border-b border-white/10 px-6" :class="sidebarCompact ? 'justify-center px-3' : ''">
                    <a asp-page="/Dashboard/Index" class="flex items-center gap-3" :class="sidebarCompact ? 'justify-center' : ''">
                        @if (!string.IsNullOrWhiteSpace(session?.TenantLogoUrl))
                        {
                            <img src="@session.TenantLogoUrl" alt="Logo da academia" class="h-12 w-12 rounded-2xl object-cover ring-1 ring-white/10" />
                        }
                        else
                        {
                            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-white">
                                <span class="text-xl font-bold">A</span>
                            </div>
                        }

                        <div x-show="!sidebarCompact" x-transition.opacity class="min-w-0">
                            <p class="truncate text-sm font-semibold text-white">@tenantName</p>
                            <p class="truncate text-xs uppercase tracking-[0.22em] text-slate-400">Painel da academia</p>
                        </div>
                    </a>
                </div>

                <div class="border-b border-white/10 px-6 py-5" :class="sidebarCompact ? 'px-3' : ''">
                    <a asp-page="/Dashboard/Profile/Index"
                       class="flex items-center gap-3 rounded-2xl transition hover:bg-white/5"
                       :class="sidebarCompact ? 'justify-center px-2 py-2' : 'px-2 py-2'">
                        @if (!string.IsNullOrWhiteSpace(session?.ProfilePhotoUrl))
                        {
                            <img src="@session.ProfilePhotoUrl" alt="Foto do usuário" class="h-12 w-12 rounded-full object-cover ring-2 ring-white/10" />
                        }
                        else
                        {
                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-sm font-semibold text-white">
                                <span>@userInitials</span>
                            </div>
                        }

                        <div x-show="!sidebarCompact" x-transition.opacity class="min-w-0">
                            <p class="truncate text-sm font-semibold text-white">@userName</p>
                            <p class="text-xs uppercase tracking-[0.18em] text-slate-400">@role</p>
                        </div>
                    </a>
                </div>

                <nav class="flex-1 overflow-y-auto px-3 py-4">
                    @foreach (var section in menuSections)
                    {
                        <div class="mb-5">
                            <p x-show="!sidebarCompact" x-transition.opacity class="px-3 text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-500">
                                @(section.Title)
                            </p>

                            <ul class="mt-2 space-y-1">
                                @foreach (var item in section.Items)
                                {
                                    var isActive = item.Matches(currentPage);

                                    if (item.HasChildren)
                                    {
                                        <li x-data="{ open: @(isActive ? "true" : "false") }" class="rounded-2xl">
                                            <button type="button"
                                                    class="dashboard-menu-item w-full justify-between"
                                                    :class="open ? 'bg-white/8 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'"
                                                    @@click="open = !open">
                                                <span class="flex items-center gap-3" :class="sidebarCompact ? 'justify-center' : ''">
                                                    <span class="dashboard-menu-icon">
                                                        <partial name="_MenuIcon" model="item.IconKey ?? string.Empty" />
                                                    </span>
                                                    <span x-show="!sidebarCompact" x-transition.opacity>@item.Label</span>
                                                </span>
                                                <svg x-show="!sidebarCompact"
                                                     xmlns="http://www.w3.org/2000/svg"
                                                     class="h-4 w-4 transition-transform"
                                                     fill="none"
                                                     viewBox="0 0 24 24"
                                                     stroke="currentColor"
                                                     stroke-width="1.8"
                                                     :class="open ? 'rotate-90' : ''">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
                                                </svg>
                                            </button>

                                            <ul x-show="open && !sidebarCompact" x-collapse class="mt-1 space-y-1 pl-5">
                                                @foreach (var child in item.Children)
                                                {
                                                    var childActive = child.Matches(currentPage);
                                                    <li>
                                                        <a asp-page="@child.PagePath"
                                                           class="dashboard-submenu-item @(childActive ? "dashboard-submenu-item-active" : string.Empty)">
                                                            @child.Label
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a asp-page="@item.PagePath"
                                               class="dashboard-menu-item @(isActive ? "dashboard-menu-item-active" : "text-slate-300 hover:bg-white/5 hover:text-white")"
                                               :class="sidebarCompact ? 'justify-center' : ''">
                                                <span class="dashboard-menu-icon">
                                                    <partial name="_MenuIcon" model="item.IconKey ?? string.Empty" />
                                                </span>
                                                <span x-show="!sidebarCompact" x-transition.opacity>@item.Label</span>
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </nav>

                <div class="border-t border-white/10 p-4" x-show="!sidebarCompact" x-transition.opacity>
                    <div class="tenant-soft-bg rounded-[1.75rem] border tenant-soft-border p-4">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Ecossistema AlphaSquad</p>
                        <p class="mt-2 text-sm leading-6 text-slate-700">
                            O menu mostra apenas os módulos contratados pela academia e respeita o perfil de quem está no painel.
                        </p>
                    </div>
                </div>
            </div>
        </aside>

        <div class="min-h-screen transition-all duration-300"
             :class="sidebarCompact ? 'lg:pl-24' : 'lg:pl-72'">
            <header class="sticky top-0 z-20 shadow-sm" style="background: var(--tenant-primary);">
                <div class="flex h-20 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center gap-3">
                        <button type="button"
                                class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-white transition hover:bg-white/15 lg:hidden"
                                @@click="sidebarOpen = true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                            </svg>
                        </button>

                        <button type="button"
                                class="hidden h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-white transition hover:bg-white/15 lg:flex"
                                @@click="sidebarCompact = !sidebarCompact">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 6.75h15M4.5 12h15M4.5 17.25h15" />
                            </svg>
                        </button>

                        <label class="hidden items-center gap-3 rounded-full bg-white px-4 py-3 shadow-sm sm:flex">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.65 7.65 0 1 0 5.85 5.85a7.65 7.65 0 0 0 10.8 10.8Z" />
                            </svg>
                            <input type="text"
                                   class="w-56 border-none bg-transparent text-sm text-slate-600 outline-none placeholder:text-slate-400"
                                   placeholder="Pesquisar no painel" />
                        </label>
                    </div>

                    <div class="flex items-center gap-3">
                        <a asp-page="/Dashboard/Profile/Index"
                           class="hidden rounded-full bg-white/10 p-3 text-white transition hover:bg-white/15 sm:inline-flex"
                           title="Meu perfil">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.964 0A9 9 0 1 0 6.018 18.725m11.964 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        </a>
                        <button type="button"
                                class="hidden rounded-full bg-white/10 p-3 text-white transition hover:bg-white/15 sm:inline-flex"
                                title="Notificações">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 1-5.714 0A2.25 2.25 0 0 1 7.5 14.856V11.25a4.5 4.5 0 1 1 9 0v3.606a2.25 2.25 0 0 1-1.643 2.226ZM9.75 21h4.5" />
                            </svg>
                        </button>
                        <div class="hidden rounded-full bg-white/10 px-4 py-2 text-right text-white/90 sm:block">
                            <p class="text-sm font-semibold">@tenantName</p>
                            <p class="text-xs uppercase tracking-[0.2em] text-white/70">@role</p>
                        </div>
                        <form method="post" asp-page="/Account/Logout">
                            <button type="submit" class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-100">
                                Sair
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="px-4 py-6 sm:px-6 lg:px-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <script defer src="https://cdn.jsdelivr.net/npm/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
