@model string

@{
    var iconName = Model switch
    {
        "dashboard" => "space_dashboard",
        "operations" => "dashboard_customize",
        "training" => "fitness_center",
        "community" => "groups",
        "management" => "admin_panel_settings",
        "profile" => "account_circle",
        "academy" => "apartment",
        "settings" => "settings",
        _ => "add_circle"
    };
}

<span class="material-symbols-rounded dashboard-material-icon" aria-hidden="true">@iconName</span>
