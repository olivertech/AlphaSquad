{
  "ConnectionStrings": {
    "DefaultConnection": "Host=__DB_HOST__;Port=5432;Database=__DB_NAME__;Username=__DB_USER__;Password=__DB_PASSWORD__"
  },
  "Jwt": {
    "Issuer": "__JWT_ISSUER__",
    "Audience": "__JWT_AUDIENCE__",
    "SecretKey": "__JWT_SECRET_KEY__",
    "ExpirationMinutes": 120
  },
  "PlatformBootstrap": {
    "Name": "__PLATFORM_OWNER_NAME__",
    "Email": "__PLATFORM_OWNER_EMAIL__",
    "Password": "__PLATFORM_OWNER_PASSWORD__"
  },
  "Redis": {
    "ConnectionString": "__REDIS_CONNECTION__",
    "InstanceName": "AlphaSquad:"
  },
  "App": {
    "EnableHttpsRedirection": true
  },
  "Storage": {
    "Provider": "CloudflareR2",
    "Endpoint": "__STORAGE_ENDPOINT__",
    "AccessKey": "__STORAGE_ACCESS_KEY__",
    "SecretKey": "__STORAGE_SECRET_KEY__",
    "BucketName": "__STORAGE_BUCKET__",
    "PublicBaseUrl": "__STORAGE_PUBLIC_BASE_URL__"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
